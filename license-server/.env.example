# PostgreSQL connection used inside docker-compose.
DATABASE_URL=postgresql://license_app:REPLACE_WITH_RANDOM_DB_PASSWORD@postgres:5432/license_db?schema=public
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD

# Generate independent random values, each at least 32 characters.
ADMIN_TOKEN=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_ADMIN_TOKEN
LICENSE_HASH_PEPPER=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_HASH_PEPPER

# Ed25519 PKCS#8 PEM. Encode line breaks as literal \n characters.
# Generate this key yourself; never commit the resulting value.
LICENSE_ED25519_PRIVATE_KEY=REPLACE_WITH_YOUR_ED25519_PRIVATE_KEY_PEM

OFFLINE_GRACE_DAYS=7
PORT=3000
